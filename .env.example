COMPOSE_PROJECT_NAME=sigme

APP_NAME=SIGME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
DEMO_MODE=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sigme
DB_TEST_DATABASE=sigme_testing
DB_USERNAME=sigme
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private-local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS="sigme@example.test"
MAIL_FROM_NAME="${APP_NAME}"

TWO_FACTOR_ENFORCE_PRIVILEGED=false
TWO_FACTOR_REQUIRED_ROLES=administrador-rede,administrador-escola,gestor

SIGME_DATA_DIR=
SIGME_UPLOAD_DIR=
SIGME_BACKUP_DIR=
SIGME_LOG_DIR=
BACKUP_DAILY_AT=20:00

APP_PORT=8080
VITE_PORT=5173
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"
