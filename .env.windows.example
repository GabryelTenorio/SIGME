# Gerado automaticamente por Instalar SIGME Docker.cmd. Nao reutilize as chaves de outro PC.
SIGME_WINDOWS_PROJECT=sigme-windows
APP_PORT=8080
MAILPIT_PORT=8025
APP_ENV=local
APP_DEBUG=false
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
DB_DATABASE=sigme
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
MAIL_MAILER=smtp
MAIL_SCHEME=null
# Mailpit captura e-mails somente neste PC. Para entrega real, substitua os
# campos MAIL_* pelo SMTP do remetente e use um endereço autorizado em MAIL_FROM_ADDRESS.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS=sigme@example.test
MAIL_FROM_NAME=SIGME
TWO_FACTOR_ENFORCE_PRIVILEGED=true
TWO_FACTOR_REQUIRED_ROLES=administrador-rede,administrador-escola,gestor
