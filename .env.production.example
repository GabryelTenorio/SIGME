# Copie para .env.production no servidor e substitua todos os valores marcados.
SIGME_PRODUCTION_PROJECT=sigme-production
APP_PORT=8080

APP_NAME=SIGME
APP_KEY=
APP_URL=https://sigme.seudominio.com.br
TRUSTED_PROXIES=*
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
BCRYPT_ROUNDS=12
LOG_LEVEL=warning

DB_DATABASE=sigme
DB_USERNAME=sigme
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_LIFETIME=120
SESSION_DOMAIN=null

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
# O provedor deve autorizar o mesmo endereço definido em MAIL_FROM_ADDRESS.
# Gmail: use smtp.gmail.com, porta 587 e uma senha de app; nunca a senha normal da conta.
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=sigme.seudominio.com.br
MAIL_FROM_ADDRESS=sigme@seudominio.com.br
MAIL_FROM_NAME=SIGME

TWO_FACTOR_REQUIRED_ROLES=administrador-rede,administrador-escola,gestor
